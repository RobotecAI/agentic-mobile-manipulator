<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rbkairos">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import rbkairos urdf file -->
    <xacro:include filename="$(find robotnik_description)/robots/rbkairos/rbkairos_plus.urdf.xacro" />

    <!-- Import control_xacro -->
    <!-- <xacro:include filename="rbkairos.ros2_control.xacro" />


    <xacro:rbkairos_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/> -->

</robot>
