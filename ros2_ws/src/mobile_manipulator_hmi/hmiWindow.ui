  <property name="styleSheet">
   <string notr="true">/* ---------- Global defaults ---------- */
/* Reduce spacing inside windows/frames */
QWidget {
    /* this doesn't set layout spacing, but keeps base font/appearance compact */
}

/* ---------- Group boxes and titles ---------- */
/* Compact group boxes */
QGroupBox {
    border: 1px solid #c0c0c0;
    border-radius: 6px;
    margin-top: 0px;           /* no extra top margin */
    padding: 4px;              /* ↓ was 16px */
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:1 #f7f7f7
    );
    font-weight: bold;
    color: #222;
}

/* Title strip */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;                 /* shift a little from border */
    padding: 0 4px;
    font-size: 20px;
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #dcdcdc);
    border: 1px solid #999;
    border-radius: 3px;        
    padding: 2px 8px;        
    min-height: 20px;      
    font-size: 20px;   
}

QPushButton:hover {
    background: #e6e6e6;
}

QPushButton:pressed {
    background: #cccccc;
}

QTableView, QTreeView, QListView {
    gridline-color: #e6e6e6;
    border: 1px solid #e0e0e0;
    font-size: 20px;
}
QTableView::item, QListView::item {
    padding: 4px 6px;
}


/* Stop button */
#StopButton {
    background-color: #d32f2f;
    color: white;
    font-weight: bold;
}

#StopButton:hover {
    background-color: #b71c1c;
}

#StopButton:pressed {
    background-color: #9a0007;
}

/* Group boxes */
QGroupBox {
    border: 1px solid #c0c0c0;
    border-radius: 12px;
    margin-top: 0px;
    padding: 16px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #f7f7f7);
    font-weight: bold;
    color: #222;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 12px;
    background: transparent;
}

/* Teleop buttons (smaller icons) */
#pushButtonTeleopFw {
    qproperty-icon: url(:/icons/Up.svg);
    qproperty-iconSize: 32px 32px;     /* ↓ was 40x40 */
}
#pushButtonTeleopBk {
    qproperty-icon: url(:/icons/Down.svg);
    qproperty-iconSize: 32px 32px;
}
#pushButtonTeleopLeft {
    qproperty-icon: url(:/icons/Left.svg);
    qproperty-iconSize: 32px 32px;
}
#pushButtonTeleopRight {
    qproperty-icon: url(:/icons/Right.svg);
    qproperty-iconSize: 32px 32px;
}
</string>
