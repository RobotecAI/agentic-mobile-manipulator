{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder WheelAnimTool/Assets": {
                    "watch": "@GEMROOT:WheelAnimTool@/Assets",
                    "recursive": 1,
                    "order": 101
                },
                "ScanFolder WheelAnimTool/Registry": {
                    "watch": "@GEMROOT:WheelAnimTool@/Registry",
                    "recursive": 1,
                    "order": 102
                }
            }
        }
    }
}
