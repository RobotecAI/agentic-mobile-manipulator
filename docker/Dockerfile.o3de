FROM base_image

# O3DE needs no apt packages to build: the pixi env provides clang, cmake, ninja
# and the system libraries the SDK .deb declares. Only the Vulkan/GL drivers the
# sim renders with at run time come from apt.
RUN apt-get update && apt-get install -y --no-install-recommends \
    mesa-vulkan-drivers \
    libglx-mesa0 \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /root/MobileManipulatorDemo

# Each step copies only what it reads, so a commit or an unrelated edit keeps the
# expensive layers cached: no .git here (gems and o3de-extras are cloned from their
# own repositories), and agent code, docs or other scripts never reach this image.
COPY pixi.toml pixi.lock ./
COPY scripts/setup_env.sh scripts/install_o3de.sh scripts/
# Unpacks the SDK to /root/.local/share/o3de (O3DE_HOME); no apt, no sudo.
RUN pixi run install-o3de

# fetch-gems validates every gem path in sim/project.json, the project's own sim/Gem included.
COPY gems.repos ./
COPY scripts/fetch_gems.sh scripts/
COPY project_gems/ project_gems/
COPY sim/ sim/
RUN git lfs install --force && pixi run fetch-gems

COPY scripts/build_sim.sh scripts/o3de_exec.sh scripts/
# build-sim depends on build-ros2, which the ros2 base image already ran. The ccache
# cache mount survives between builds, so a rebuild recompiles only changed sources.
RUN --mount=type=cache,target=/root/.cache/ccache pixi run --skip-deps build-sim
# Ship the conda packages' licence texts with the image (see THIRD_PARTY.md):
# they live in the pixi package cache, not in the environment.
COPY scripts/collect_conda_licenses.py scripts/
RUN pixi run collect-licenses

WORKDIR /root/MobileManipulatorDemo
CMD ["bash"]
