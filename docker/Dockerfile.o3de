ARG ROS2_IMAGE=mobile-manipulator-demo-ros2:latest
FROM ${ROS2_IMAGE}

ENV O3DE_ROOT=/opt/O3DE/26.05

# Install O3DE build dependencies and the 26.05 SDK
# Note: git, git-lfs, ninja-build, ros-dev-tools, pixi are inherited from base image
RUN apt update && apt install -y \
    cmake \
    libstdc++-12-dev \
    clang \
    libglu1-mesa-dev \
    libxcb-randr0-dev \
    libxcb-xinerama0 \
    libxcb-xinput0 \
    libxcb-xinput-dev \
    libxcb-xfixes0-dev \
    libxcb-xkb-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    libfontconfig1-dev \
    libpcre2-16-0 \
    zlib1g-dev \
    mesa-common-dev \
    libunwind-dev \
    libzstd-dev \
    tix \
    wget \
 && wget -q https://o3debinaries.org/main/Latest/Linux/o3de_2605_0.deb -O /tmp/o3de.deb \
 && dpkg -i /tmp/o3de.deb \
 && rm /tmp/o3de.deb \
 && apt clean && rm -rf /var/lib/apt/lists/*

WORKDIR /root/MobileManipulatorDemo

# Refresh pixi task definitions so cmake flags, SDK path, etc. are current
COPY pixi.toml pixi.lock pixi_activate.sh gems.repos ros2_ws.repos ./

# .git is required for gems LFS pull inside register-project
COPY .git .git/
COPY sim sim/
COPY project_gems project_gems/

# build-o3de handles: register-project (setup-o3de + clone-gems + gem cleanup),
# build-ros2 (incremental — sources+install already present from base image), cmake configure+build
RUN pixi run build-o3de

WORKDIR /root/MobileManipulatorDemo
CMD ["bash"]
