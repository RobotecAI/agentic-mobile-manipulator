repositories:
  # Robotnik vendor packages — not published on RoboStack, built from source.
  ros2_ws/src/packages/robotnik_common:
    type: git
    url: https://github.com/RobotnikAutomation/robotnik_common.git
    version: 69ba228d3b7fe711c0b18ca415ef6e88e5ddc217
  ros2_ws/src/packages/robotnik_description:
    type: git
    url: https://github.com/RobotnikAutomation/robotnik_description.git
    version: cb04bab2607f6d803f36dafdf83aa62231506605
  ros2_ws/src/packages/robotnik_sensors:
    type: git
    url: https://github.com/RobotnikAutomation/robotnik_sensors.git
    version: e639e55ae2554dd5ec7f082c12cc5ab5add7b6d7

  # RobotecAI custom interfaces — tracks a feature branch, never a released binary.
  ros2_ws/src/packages/rai_interfaces:
    type: git
    url: https://github.com/RobotecAI/rai_interfaces.git
    version: feat/nav2-ai

# NOTE: The following packages were removed on migration to RoboStack — they are
# now installed as conda packages via pixi.toml instead of being vcs-imported and
# colcon-built:
#   Universal_Robots_ROS2_Description -> ros-jazzy-ur-description
#   control_msgs                      -> ros-jazzy-control-msgs
#   control_toolbox                   -> ros-jazzy-control-toolbox
#   kinematics_interface              -> ros-jazzy-kinematics-interface
#   moveit2                           -> ros-jazzy-moveit + ros-jazzy-moveit-py
#   moveit_msgs                       -> ros-jazzy-moveit-msgs
#   realtime_tools                    -> ros-jazzy-realtime-tools
#   ros2_control                      -> ros-jazzy-ros2-control
#   ros2_controllers                  -> ros-jazzy-ros2-controllers
#   srdfdom                           -> ros-jazzy-srdfdom
